POSTGRES_PASSWORD=replace-with-long-random-secret
REDIS_PASSWORD=replace-with-long-random-secret
RABBITMQ_PASSWORD=replace-with-long-random-secret
NOTIFY_WEBHOOK_URL=
AI_MODELS=

# Operator authorization for hardware-affecting endpoints
OPERATOR_TOKEN=replace-with-long-random-operator-token
CORS_ORIGINS=http://localhost:5173

# Neural control plane. Local Ollama can run with zero API spend.
AI_PROVIDER_ORDER=ollama,openai,gemini,anthropic,openai_compatible
AI_PROVIDER_PERMISSIONS={"ollama":{"enabled":true,"purposes":["advisory","event_analysis","vision_summary","engineering"],"max_output_tokens":1200},"openai":{"enabled":false,"purposes":["advisory","event_analysis","vision_summary","engineering"],"max_output_tokens":1200},"gemini":{"enabled":false,"purposes":["advisory","event_analysis","vision_summary","engineering"],"max_output_tokens":1200},"anthropic":{"enabled":false,"purposes":["advisory","event_analysis","vision_summary","engineering"],"max_output_tokens":1200},"openai_compatible":{"enabled":false,"purposes":["advisory","engineering"],"max_output_tokens":1200}}
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
COMPAT_API_KEY=
COMPAT_BASE_URL=
COMPAT_MODEL=local-model

# Dashboard build-time token for protected operator actions (do not commit real value)
VITE_OPERATOR_TOKEN=

CONJUNTO_AI_URL=http://ai:8000
CONJUNTO_AI_SERVICE_TOKEN=replace-with-the-same-internal-service-token

# Per-equipment HMAC secrets. Generate unique 256-bit random values per physical device.
EQUIPMENT_HMAC_KEYS_JSON={"drone-01":"replace-with-random-secret"}

# --- Endurecimiento (opcional pero recomendado en producción) ---
# Clave compartida edge-gateway -> ingestion. Si se define, /ingest rechaza llamadas sin X-Ingest-Key.
INGEST_API_KEY=
# true = los GET sensibles del orquestador (aprobaciones, journal, equipos) exigen X-Operator-Token.
REQUIRE_AUTH_FOR_READS=false
# Tope de eventos en el buffer local del edge (se descartan primero los de menor prioridad).
BUFFER_MAX_EVENTS=50000
