# ==========================================================
# Conjunto Inteligente · Variables del stack Docker
# Copia a `.env` y rellena con valores reales.
# `.env` está en .gitignore y NUNCA se sube al repo.
# ==========================================================

# ── Proyecto ─────────────────────────────────────────────
COMPOSE_PROJECT_NAME=conjunto
TZ=America/Bogota

# ── PostgreSQL ───────────────────────────────────────────
POSTGRES_USER=ci
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=conjunt_inteligente
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=change-me-in-production
REDIS_PORT=6379

# ── RabbitMQ ─────────────────────────────────────────────
RABBITMQ_USER=ci
RABBITMQ_PASSWORD=change-me-in-production
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ── MinIO ────────────────────────────────────────────────
MINIO_ROOT_USER=ci
MINIO_ROOT_PASSWORD=change-me-minio-in-production
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=conjunto-docs

# ── Mosquitto (MQTT) ─────────────────────────────────────
MQTT_USER=ci
MQTT_PASSWORD=change-me-mqtt-in-production
MQTT_PORT=1883
MQTT_WS_PORT=9002

# ── API .NET ─────────────────────────────────────────────
API_PORT=5000
API_HTTP_PORT=5000
API_HTTPS_PORT=5001
PB_SERVICE_TOKEN=change-me-pb-token-32-chars-min

# ── IA (Python) ──────────────────────────────────────────
AI_PORT=8000
AI_LLM_PROVIDER=deterministic
AI_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Edge Gateway (C++) ───────────────────────────────────
EDGE_HEALTH_PORT=8080
EDGE_LOG_LEVEL=INFO

# ── Web Admin ────────────────────────────────────────────
WEB_ADMIN_PORT=5173

# ── PB Bridge ────────────────────────────────────────────
PB_BRIDGE_PORT=5100

# ── Observabilidad ───────────────────────────────────────
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4319
TEMPO_OTLP_HTTP_PORT=4320

# ── WhatsApp (fase posterior) ────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ── SMTP (fase posterior) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@conjunto.local
