{
  "version": 1,
  "author": "Conjunto Inteligente",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-pir-motion-sensor", "id": "pir1", "top": 80, "left": -120,
      "attrs": { "delay": "1" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 200,
      "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 100, "left": 200,
      "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX0",  "$serialMonitor:RX", "", [] ],
    [ "esp:RX0",  "$serialMonitor:TX", "", [] ],
    [ "pir1:VCC", "esp:3V3",  "red",    [] ],
    [ "pir1:GND", "esp:GND.1","black",  [] ],
    [ "pir1:OUT", "esp:D27",  "green",  [] ],
    [ "led1:A",   "r1:1",     "red",    [] ],
    [ "r1:2",     "esp:D2",   "orange", [] ],
    [ "led1:C",   "esp:GND.2","black",  [] ]
  ]
}
