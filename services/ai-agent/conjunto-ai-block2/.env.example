AI__SERVICE_NAME=conjunto-ai
AI__ENV=development
AI__LLM_PROVIDER=deterministic
AI__LLM_ALLOWED_PROVIDERS=deterministic,ollama,openai,gemini,anthropic,openai_compatible
CORE__BASE_URL=http://api:5000
CORE__TIMEOUT_SECONDS=5
CORE__MAX_RETRIES=3
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=conjunto-ai

# Phase 5 LLM orchestration
# Comma-separated priority order. Use deterministic for offline mode.
AI__LLM_PROVIDER=deterministic
AI__LLM_ALLOWED_PROVIDERS=deterministic,ollama,openai,gemini,anthropic,openai_compatible
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI__OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
AI__COMPAT_BASE_URL=
AI__COMPAT_MODEL=local-model
AI__COMPAT_API_KEY=
AI__LLM_TIMEOUT_SECONDS=20
AI__LLM_FAILURE_THRESHOLD=3
AI__LLM_COOLDOWN_SECONDS=30
AI__LLM_MAX_INPUT_CHARS=30000
AI__LLM_MAX_OUTPUT_CHARS=12000

# Internal service authentication for trusted platform integrations
AI__INTERNAL_SERVICE_TOKEN=replace-with-long-random-service-token
